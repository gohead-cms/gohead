{
  "name": "@gohead-cms/create",
  "version": "0.8.0",
  "description": "Create a website on GoHead from a starter template: npm create @gohead-cms@latest",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gohead-cms/gohead.git",
    "directory": "sdk/create"
  },
  "homepage": "https://gohead-cms.github.io/gohead/frontend/templates/",
  "keywords": [
    "gohead",
    "headless-cms",
    "starter",
    "template",
    "nextjs",
    "create"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "bin": {
    "create-gohead": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "bundle-templates": "node scripts/bundle-templates.mjs",
    "test": "vitest run",
    "prepack": "npm run build && npm run bundle-templates"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
