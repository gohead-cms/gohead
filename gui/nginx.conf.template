# Rendered by the nginx image's envsubst step at container start.
server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;

    # Runtime configuration for the SPA.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.__GOHEAD_CONFIG__ = { apiBaseUrl: "${GOHEAD_API_URL}" };';
    }

    # Fingerprinted build assets can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }
}
