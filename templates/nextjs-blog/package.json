{
  "name": "gohead-nextjs-blog",
  "version": "0.1.0",
  "private": true,
  "description": "A Next.js blog starter for the GoHead headless CMS.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "gohead:push": "gohead-client model push gohead/model.json",
    "gohead:seed": "gohead-client seed gohead/seed.json",
    "gohead:types": "gohead-client types --model gohead/model.json --out src/gohead.d.ts",
    "gohead:setup": "npm run gohead:push && npm run gohead:seed && npm run gohead:types"
  },
  "dependencies": {
    "@gohead-cms/client": "^0.6.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
