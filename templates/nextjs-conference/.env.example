# Copy to .env.local and adjust (`npm create @gohead-cms` does it for you).
# Next.js and the setup scripts read it; never commit it.
# `npm run gohead:access` and `npm run gohead:agents` fill in the tokens and
# secrets below.

# ---- Read by the site (server side only) ----

# Where GoHead runs (no /api suffix).
GOHEAD_URL=http://localhost:8080

# Optional. The site reads what GoHead's public role allows (gohead/model.json
# opens the site's types to it), so no token is needed. For a private
# instance, create a read-only token:
#   npx gohead-client token create --name website --role viewer
GOHEAD_TOKEN=

# The forms (questions, call for papers, newsletter): an API token of the
# `site-forms` role, which may create those entries and upload files, nothing
# else. Created by `npm run gohead:access`.
GOHEAD_FORMS_TOKEN=

# Draft mode: an API token of the `site-preview` role (it sees drafts of talks
# and posts), and the secret of /api/preview?secret=…. Created by
# `npm run gohead:access`.
GOHEAD_PREVIEW_TOKEN=
GOHEAD_PREVIEW_SECRET=

# Signing secret (whsec_…) of the webhook that calls /api/revalidate. Created
# with the webhook by `npm run gohead:access`.
GOHEAD_WEBHOOK_SECRET=

# The feedback form posts to the `feedback-desk` agent's webhook. Created by
# `npm run gohead:agents`.
GOHEAD_FEEDBACK_AGENT_ID=
GOHEAD_FEEDBACK_AGENT_TOKEN=

# Seconds a GoHead read stays cached before it is refetched (default 60).
# With the webhook set up, you can raise it, or use "false" to rely on it only.
GOHEAD_REVALIDATE=60

# Optional. GoHead's public address, when GOHEAD_URL is an internal one (e.g.
# http://gohead:8080 in Docker): links to uploaded files use it.
GOHEAD_PUBLIC_URL=

# Optional. Public base URL of uploaded files when GoHead stores them in S3 or
# behind a CDN, e.g. https://cdn.example.com/media (needed by next/image).
GOHEAD_MEDIA_URL=

# Public URL of this site, for canonical links, Open Graph, the sitemap, RSS
# and the calendar file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Read by the setup scripts only (npm run gohead:*) ----

# An admin account of GoHead. docker-compose.yml creates this one on first
# start; use your own for any other instance. Not needed by the site itself:
# don't set them where you deploy it.
GOHEAD_USERNAME=admin
GOHEAD_PASSWORD=gohead-local-password

# Where GoHead delivers the revalidation webhook: this site, as GoHead sees
# it. From the containers of docker-compose.yml, your machine is
# host.docker.internal (the default). With GoHead running directly on your
# machine, use http://localhost:3000/api/revalidate.
GOHEAD_REVALIDATE_URL=
